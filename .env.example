# Offline Event Feedback: environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Nothing in this file belongs in a screenshot, a ticket or a chat message.

# ---------------------------------------------------------------------------
# Central sync server (server/)
#
# These are SERVER-SIDE ONLY. They must never appear in a VITE_ variable, in
# `define`, or anywhere else that reaches the browser bundle; anything shipped
# to a device is readable by anyone who has that device.
# ---------------------------------------------------------------------------

# The connection the running application uses.
#
# Any hosted Postgres works. On a serverless deployment this must be the
# POOLED connection string: many short-lived function instances each open their
# own connection, and a pooler is what keeps that from exhausting the database.
# (Neon calls it the pooled endpoint; it is the one with `-pooler` in the host.)
DATABASE_URL=postgres://user:password@localhost:5432/offline_event_feedback

# The connection MIGRATIONS use. Operator-only; the application never reads it.
#
# This must be the DIRECT / UNPOOLED connection. A transaction-mode pooler
# cannot hold the session state that DDL relies on, and migrations are exactly
# where that matters. `pnpm server:migrate` prefers this, then
# DATABASE_URL_UNPOOLED, then DATABASE_URL, so a single local Postgres needs
# nothing set here at all.
#
# Migrations are never run automatically: not on server start, not on a deploy,
# not on the first request.
MIGRATION_DATABASE_URL=

# The code an operator types once, on each device, to enrol it.
#
# Generate a long random value, for example:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
#
# It is compared in constant time and never stored on either side. Rotate it
# after the event; enrolled devices keep working, since each holds its own token.
SYNC_ENROLLMENT_SECRET=replace-me-with-a-long-random-value

# Browser origins permitted to call the API CROSS-ORIGIN, comma separated. No
# wildcard: authenticated ingest must not be drivable from any page a staff
# member happens to have open.
#
# Needed for the local split-origin setup, where a Vite dev server on :5173
# calls this API on :8788. A production deployment that serves the app and the
# API from one origin needs NOTHING here: a same-origin request is not subject
# to CORS at all, and listing generated deployment hostnames would be both
# fragile and pointless.
#
# The same list governs reporting, which adds GET requests to these origins.
SYNC_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# The credential for CENTRAL REPORTING: the only API that returns participant
# names, phone numbers and email addresses.
#
# Deliberately NOT the enrolment secret and not a device token. An enrolled
# tablet may upload what it captured; nothing about that should let it read the
# whole venue's contact list.
#
# A memorable password is fine. There is no minimum length: this is typed by
# hand, and a generated string nobody can type ends up written on the venue desk.
# Pick something you would be happy to defend as a password.
#
# Avoid spaces. It is sent as an HTTP Bearer credential, which is a single
# whitespace-free token, so a value with a space in it cannot be submitted at
# all. Letters, digits and symbols are fine.
#
# It must NOT be the same value as SYNC_ENROLLMENT_SECRET: the server refuses to
# start if it is. One value pasted into both variables looks correctly
# configured and hands every tablet operator the venue's contact list.
#
# Rules, all enforced or verified in code:
#   - never in a query string, a log line, or a backup file
#   - never in a VITE_ variable; that would ship it inside the browser bundle
#   - never stored by the browser: the screen holds it in memory only
#
# Leave it unset and reporting fails CLOSED (503) while sync keeps working.
REPORTING_ADMIN_SECRET=

PORT=8788

# ---------------------------------------------------------------------------
# Client (src/)
#
# Build-time and therefore PUBLIC. This is a location, never a credential.
# ---------------------------------------------------------------------------

# Where the sync server lives. Leave unset to build with synchronisation
# cleanly disabled. Point A, Point B and backup are unaffected either way.
#
# Three shapes are valid:
#
#   /api                     production. The app and the API are one deployment,
#                            so this resolves against the page's own origin and
#                            inherits its HTTPS by construction.
#   https://api.example.com  a deliberately separate, encrypted API host.
#   http://localhost:8788    local development, where the split origin is the
#                            point.
#
# Anything else over plain HTTP FAILS the production build: registrations carry
# names, phone numbers and email addresses.
VITE_SYNC_API_BASE_URL=http://localhost:8788
