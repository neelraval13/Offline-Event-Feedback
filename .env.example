# Offline Event Feedback — environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Nothing in this file belongs in a screenshot, a ticket or a chat message.

# ---------------------------------------------------------------------------
# Central sync server (server/)
#
# These are SERVER-SIDE ONLY. They must never appear in a VITE_ variable, in
# `define`, or anywhere else that reaches the browser bundle — anything shipped
# to a device is readable by anyone who has that device.
# ---------------------------------------------------------------------------

# Standard Postgres connection string. Any hosted Postgres works.
DATABASE_URL=postgres://user:password@localhost:5432/offline_event_feedback

# The code an operator types once, on each device, to enrol it.
#
# Generate a long random value, for example:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
#
# It is compared in constant time and never stored on either side. Rotate it
# after the event; enrolled devices keep working, since each holds its own token.
SYNC_ENROLLMENT_SECRET=replace-me-with-a-long-random-value

# Browser origins permitted to sync, comma separated. No wildcard: authenticated
# ingest must not be drivable from any page a staff member happens to have open.
#
# The same list governs reporting, which adds GET requests to these origins.
SYNC_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# The credential for CENTRAL REPORTING — the only API that returns participant
# names, phone numbers and email addresses.
#
# Deliberately NOT the enrolment secret and not a device token. An enrolled
# tablet may upload what it captured; nothing about that should let it read the
# whole venue's contact list.
#
# Generate one, at least 32 characters (the server refuses to start otherwise):
#   openssl rand -hex 32
#
# It must NOT be the same value as SYNC_ENROLLMENT_SECRET: the server refuses to
# start if it is. One generated value pasted into both variables looks correctly
# configured and hands every tablet operator the venue's contact list.
#
# Rules, all enforced or verified in code:
#   - never in a query string, a log line, or a backup file
#   - never in a VITE_ variable — that would ship it inside the browser bundle
#   - never stored by the browser: the screen holds it in memory only
#
# Leave it unset and reporting fails CLOSED (503) while sync keeps working.
REPORTING_ADMIN_SECRET=

PORT=8788

# ---------------------------------------------------------------------------
# Client (src/)
#
# Build-time and therefore PUBLIC. This is a location, never a credential.
# ---------------------------------------------------------------------------

# Where the sync server lives. Leave unset to build with synchronisation
# cleanly disabled — Point A, Point B and backup are unaffected either way.
#
# Production MUST be https: registrations carry participant contact details.
# `localhost` is exempt for development only.
VITE_SYNC_API_BASE_URL=http://localhost:8788
