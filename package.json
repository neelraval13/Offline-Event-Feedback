{
  "name": "offline-event-feedback",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-pwa-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "server:migrate": "tsx server/migrate.ts",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "server:test": "vitest run --config server/vitest.config.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "0.23.0",
    "dexie": "^4.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1",
    "workbox-window": "7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "hono": "^4.13.2",
    "jsdom": "^30.0.1",
    "postgres": "^3.4.9",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
